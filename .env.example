# Public site URL (used for canonical URLs, sitemap and Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.nexionlabs.com.au

# Email delivery for the contact form.
# EMAIL_PROVIDER: "resend" (default) or "console" (logs submissions instead of sending; handy locally).
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be an address on a domain you have verified in Resend.
CONTACT_FROM_EMAIL="NexIon Labs Website <website@nexionlabs.com.au>"
# Where enquiries are delivered.
CONTACT_TO_EMAIL=hello@nexionlabs.com.au
